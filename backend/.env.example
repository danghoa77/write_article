# Default copied from gen_slug1; optional override.
ARTICLE_SLUG_SUFFIX=danghoa123

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
# Set the GPT model available to your API project before choosing textProvider=gpt.
OPENAI_MODEL=
SERPER_API_KEY=
TAVILY_API_KEY=
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_LIST_ID=6a5c28f07ad71ddd0ab39e28

# Backend only: compact JSON from Firebase -> Project settings -> Service accounts.
# Do not use the Firebase Web App config here.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional dedicated signing key for browser sessions (random 32+ bytes).
# If omitted, a domain-separated key is derived from the existing server-only Firebase credential.
# Rotating either signing source signs out existing browser sessions.
BROWSER_SESSION_SECRET=

# Optional dedicated key for encrypting workspace API keys at rest.
# Keep stable across deployments. Empty uses a separate derivation from Firebase server credentials.
WORKSPACE_ENCRYPTION_KEY=
